{
  "realm": "spine",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access to all resources"
      },
      {
        "name": "operator",
        "description": "Can manage agents and view observability"
      },
      {
        "name": "viewer",
        "description": "Read-only access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "spine-dashboard",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "spine-chat",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["http://localhost:3002"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "spine-services",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-in-production",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "scopeMappings": [
    {
      "client": "spine-services",
      "roles": ["admin"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@spine.local",
      "firstName": "Spine",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "operator",
      "enabled": true,
      "email": "operator@spine.local",
      "firstName": "Spine",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": ["operator"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@spine.local",
      "firstName": "Spine",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    }
  ]
}
