# =============================================================================
# Agent Control Spine — Environment Variables (Factor III)
# =============================================================================
# Copy to .env and fill in values. All services load config from env vars only.

# -----------------------------------------------------------------------------
# PostgreSQL (Factor IV — backing service)
# -----------------------------------------------------------------------------
POSTGRES_USER=spine
POSTGRES_PASSWORD=spine-dev-password
POSTGRES_DB=spine
DATABASE_URL=postgresql+asyncpg://spine:spine-dev-password@postgres:5432/spine

# -----------------------------------------------------------------------------
# Redis (Factor IV — backing service)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# NATS (Factor IV — backing service)
# -----------------------------------------------------------------------------
NATS_URL=nats://nats:4222

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8443
KEYCLOAK_REALM=spine
KEYCLOAK_CLIENT_ID_SERVICES=spine-services
KEYCLOAK_CLIENT_SECRET_SERVICES=change-me-in-production

# JWT verification (service-level defense-in-depth)
# JWKS URL uses the internal Docker hostname; issuer matches the iss claim in tokens
KEYCLOAK_JWKS_URL=http://keycloak:8443/realms/spine/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8443/realms/spine
# Set to true ONLY for local development without Keycloak (skips JWT verification)
AUTH_DISABLED=false

# -----------------------------------------------------------------------------
# AgentGateway
# -----------------------------------------------------------------------------
AGENTGATEWAY_URL=http://agentgateway:8080

# -----------------------------------------------------------------------------
# Ollama (local LLM provider)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# -----------------------------------------------------------------------------
# Langfuse (LLM observability)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3003

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=spine

# -----------------------------------------------------------------------------
# Frontend — Dashboard (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Auth.js v5 — Keycloak OIDC provider
AUTH_SECRET_DASHBOARD=generate-a-random-32-char-secret-here
AUTH_KEYCLOAK_SECRET_DASHBOARD=spine-dashboard-secret
# Direct service URLs (server-side only, used for health probes and prom queries)
REGISTRY_URL=http://localhost:8081
CATALOG_URL=http://localhost:8082
OBSERVER_URL=http://localhost:8083
CHAT_URL=http://localhost:8084
PROMETHEUS_URL=http://localhost:9090

# -----------------------------------------------------------------------------
# Frontend — Chat (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8080
NEXT_PUBLIC_CHAT_KEYCLOAK_CLIENT_ID=spine-chat
AUTH_CHAT_SECRET=generate-a-different-random-secret-here

# -----------------------------------------------------------------------------
# Service ports (for local development)
# -----------------------------------------------------------------------------
REGISTRY_PORT=8081
CATALOG_PORT=8082
OBSERVER_PORT=8083
CHAT_PORT=8084
DASHBOARD_PORT=3001
CHAT_APP_PORT=3002
