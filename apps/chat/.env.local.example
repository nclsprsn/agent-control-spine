# Auth.js (Keycloak OIDC)
AUTH_KEYCLOAK_ID=spine-chat
AUTH_KEYCLOAK_SECRET=spine-chat-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8443/realms/spine
AUTH_SECRET=dev-secret-change-in-production-32chars
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3002

# Gateway URL (used server-side by the API proxy route)
GATEWAY_INTERNAL_URL=http://localhost:8080
